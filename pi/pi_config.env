# shellcheck shell=bash
# pi/pi_config.env - the single parameter file for every pi/*.sh script.
#
# Sourced by pi/lib/common.sh (before anything else happens); every script prints the effective values
# (print_config). Format: plain bash assignments, no commands with side effects.
#
# Precedence: a variable that is already set in the environment WINS over the default written here, so
# one-off overrides work without editing this file:
#     THREADS=3 CTX=2048 pi/05_run.sh bench
#     MODEL_DIR=/mnt/nvme/models pi/00_feasibility.sh
# Variables written as ${VAR-default} (no colon) also honour an explicitly EMPTY environment value
# (e.g. DENY_HOSTS= keeps the deny list empty); ${VAR:-default} replaces an empty value by the default.
# PIGEMMA_CONFIG=/path/to/other.env makes common.sh source a different file instead of this one.
#
# Exit-code convention shared by every pi script (pigemma.feasibility uses the same numbers):
#     0 ok | 1 usage/internal error | 2 only slow streaming possible | 3 not viable / precondition failed
#     4 refused (protected or busy host)
#
# Defaults verified against docs/design/FACTS.md (2026-10-05).

# ------------------------------------------------------------------------------------------- locations
# PIGEMMA_HOME: the repo checkout on the Pi (auto: the directory above pi/).
if [ -z "${PIGEMMA_HOME:-}" ]; then
    PIGEMMA_HOME="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." 2>/dev/null && pwd)"
fi
# MODEL_DIR: where GGUFs live. Point it at the NVMe / USB-SSD mount when there is one
# (e.g. /mnt/nvme/models): storage type, link speed and free disk are measured on THIS path.
MODEL_DIR="${MODEL_DIR:-$PIGEMMA_HOME/models}"
# LLAMA_DIR: llama.cpp checkout + build (binaries in $LLAMA_DIR/build/bin; PIGEMMA_LLAMA_BIN overrides).
LLAMA_DIR="${LLAMA_DIR:-${HOME:-/root}/llama.cpp}"
# LLAMA_COMMIT: pinned llama.cpp commit (= build b11398, same as the desktop measurements).
LLAMA_COMMIT="${LLAMA_COMMIT:-a7b94df}"
# PIGEMMA_OUT: per-host outputs (facts.json, feasibility.json, build.json, hotset, pinner.pid ...).
PIGEMMA_OUT="${PIGEMMA_OUT:-$PIGEMMA_HOME/pi/out}"

# ------------------------------------------------------------------------------------------- runtime
# THREADS: llama.cpp -t (Pi 5 = 4 x Cortex-A76).
THREADS="${THREADS:-4}"
# CTX: llama.cpp -c (KV cache size is part of the feasibility arithmetic).
CTX="${CTX:-4096}"
# QUANT_OVERRIDE: force a quant (e.g. UD-Q3_K_M) instead of the feasibility recommendation (pi/04, pi/05).
QUANT_OVERRIDE="${QUANT_OVERRIDE:-}"
# OS_RESERVE_GIB: RAM kept for the OS + services; empty = catalog device profile / RAM-tier rule
# (0.7 GB <= 4 GB, 0.8 GB 8 GB, 0.9 GB >= 16 GB). Read by pigemma.feasibility from the environment.
OS_RESERVE_GIB="${OS_RESERVE_GIB:-}"
# MIN_FREE_DISK_FACTOR: a download needs free disk >= factor x file bytes.
MIN_FREE_DISK_FACTOR="${MIN_FREE_DISK_FACTOR:-1.1}"
# KEEP_FREE_GB: never let the ROOT filesystem drop below this many GB (1e9) free (FACTS safety rule
# for the real Pi: keep >= 2 GB free at all times). Applied by require_free_disk when the target path
# lives on the root filesystem.
KEEP_FREE_GB="${KEEP_FREE_GB:-2}"
# NICE_LEVEL: builds, downloads and inference run under nice -n $NICE_LEVEL (downloads also ionice -c3).
NICE_LEVEL="${NICE_LEVEL:-10}"

# ------------------------------------------------------------------------------------- host safety
# DENY_HOSTS: hostnames on which every script refuses (exit 4) unless PIGEMMA_I_KNOW=1.
# Space or comma separated. EMPTY by default since 2026-10-05: context-friend-1 is now the real target
# Pi (the operator: "it's a new pi5 ... we can then test directly there"). The catalog's protected_hosts list
# (pigemma/data/catalog.json) is ALSO enforced by assert_safe_host and pigemma.feasibility.
DENY_HOSTS="${DENY_HOSTS-}"
# PROTECTED_SERVICE_GLOBS: running systemd services matching any glob make the host "protected"
# (exit 4 unless PIGEMMA_I_KNOW=1). context-friend-1 runs contextfriend-box / contextfriend-gpu-tunnel.
PROTECTED_SERVICE_GLOBS="${PROTECTED_SERVICE_GLOBS-contextfriend* context-friend*}"
# PIGEMMA_I_KNOW=1: explicit, authorised override of the protected-host refusal (never of the busy-host
# refusal). Real-Pi runs on context-friend-1 use it (authorised by the operator 2026-10-05) and results say so.
# Even with the override: no mlock of model weights on that host (see ALLOW_MLOCK), nice -n 10, keep
# KEEP_FREE_GB free, never stop/restart/kill services, never edit config.txt or reboot without approval.
PIGEMMA_I_KNOW="${PIGEMMA_I_KNOW:-0}"
# ALLOW_MLOCK: auto = mlock of model weights allowed only on hosts that are not protected (on an
# overridden protected host the page cache must stay reclaimable for its services); 1 = always; 0 = never.
ALLOW_MLOCK="${ALLOW_MLOCK:-auto}"

# ------------------------------------------------------------------------------------- OS tuning (pi/01)
# TUNE_APPLY=1 is equivalent to pi/01_tune_os.sh --apply (default: dry run, prints the plan only).
TUNE_APPLY="${TUNE_APPLY:-0}"
# TUNE_NVME_GEN3=1 proposes dtparam=pciex1_gen=3 in /boot/firmware/config.txt (uncertified Gen3 x1,
# ~850 MB/s); only when an NVMe is present and no AI HAT occupies the lane. Never reboots.
TUNE_NVME_GEN3="${TUNE_NVME_GEN3:-0}"
# TUNE_GOVERNOR: cpufreq governor to set (performance avoids ondemand ramp-up during decode).
TUNE_GOVERNOR="${TUNE_GOVERNOR:-performance}"
# TUNE_SWAPPINESS: vm.swappiness (low = keep the page cache / mapped weights resident).
TUNE_SWAPPINESS="${TUNE_SWAPPINESS:-10}"
# TUNE_READAHEAD_KB: read_ahead_kb on the model device (expert slabs are 1.1-2.2 MB contiguous).
TUNE_READAHEAD_KB="${TUNE_READAHEAD_KB:-2048}"
# TUNE_MEMLOCK=1 proposes memlock unlimited (limits.d + systemd DefaultLimitMEMLOCK; re-login needed).
TUNE_MEMLOCK="${TUNE_MEMLOCK:-1}"

# ------------------------------------------------------------------------------------- build / fetch / pin
# BUILD_JOBS: auto = min(nproc, floor(MemAvailable_GiB / 1.2), 4) (2 on a 4 GB board); or a number.
BUILD_JOBS="${BUILD_JOBS:-auto}"
# HF_LIMIT_RATE: curl --limit-rate for model downloads (e.g. 5M); empty = unlimited.
HF_LIMIT_RATE="${HF_LIMIT_RATE:-}"
# PIN_BUDGET_BYTES: pi/06 hot-set budget; auto = MemAvailable - KV(ctx) - 0.3e9 compute - 0.5e9 headroom.
PIN_BUDGET_BYTES="${PIN_BUDGET_BYTES:-auto}"
