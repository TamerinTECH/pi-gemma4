# pi/03_bench_io_mem.sh job set (data_formats io_mem.json), short runtimes for a fixture capture.
[global]
filename=/tmp/pigemma-fio-test.bin
size=256m
direct=1
ioengine=libaio
runtime=2
time_based=1
group_reporting=0

[seq_read_qd1]
rw=read
bs=1M
iodepth=1

[seq_read_qd8]
stonewall
rw=read
bs=1M
iodepth=8

[rand_read_3mb_qd1]
stonewall
rw=randread
bs=3345k
iodepth=1

[rand_read_3mb_qd4]
stonewall
rw=randread
bs=3345k
iodepth=4

[rand_read_16k_qd1]
stonewall
rw=randread
bs=16k
iodepth=1
